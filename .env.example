# 이 파일을 .env 로 복사해 값을 채우면 매번 export 하지 않아도 된다. .env 는 git에 넣지 않는다.
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=none
LLM_MODEL=qwen2.5-7b-instruct-1m
LLM_CONCURRENCY=2
# OpenRouter 라면:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=qwen/qwen-2.5-7b-instruct
# LLM_PROVIDER=Phala
# LLM_CONCURRENCY=8
# Improver 를 다른 모델로:
# IMPROVER_LLM_MODEL=qwen2.5-14b-instruct-1m
